# Виртуальное окружение
.venv/
venv/
env/

# Кэш Python и тестов
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# macOS
.DS_Store

# Журналы и временные файлы
logs/*.log
logs/*.log.*
*.tmp
*.partial
~$*

# Отчёт, который создаёт программа
output/*.xlsx
output/*.xls
output/*.partial

# Чужие книги, положенные в input вручную.
# Учебный пример source_sales.xlsx в репозиторий входит.
input/*.xlsx
!input/source_sales.xlsx
input/*.xls
input/*.xlsm
input/*.xlsb

# Архивы и резервные копии
*.zip
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tbz2
*.tar.xz
*.txz
*.7z
*.rar
*.gz
*.bz2
*.xz
*.bak
*.backup
*.old
*.orig
*~

# Секреты и локальные настройки.
# Демонстрационные шаблоны .env.example остаются в репозитории.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
secrets.json
credentials.json
credentials.txt
local.settings.json
id_rsa
id_dsa
id_ecdsa
id_ecdsa_sk
id_ed25519
id_ed25519_sk
id_xmss
*.pem
*.key
*.ppk
